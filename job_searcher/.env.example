# Google Gemini API key (from Google AI Studio) used for JD parsing, matching, and email drafting
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to use for structured extraction/matching/drafting calls
GEMINI_MODEL=gemini-3.5-flash-lite

# Minimum match score (0-100) required for auto-alignment without confirmation
MATCH_SCORE_THRESHOLD=65

# --- CLI (main.py) only - personal, single-user, uses the Desktop OAuth flow below ---
PROFILE_PATH=data/profile.md
JOBS_HISTORY_PATH=data/jobs_history.json
GMAIL_CREDENTIALS_PATH=credentials/credentials.json
GMAIL_TOKEN_PATH=credentials/token.json
# PDF resume file auto-attached to Gmail drafts (skipped if this file doesn't exist)
RESUME_FILE_PATH=data/resume.pdf

# --- Web app (backend/) and Discord bot (discord_bot/) - shared, multi-user ---
# OAuth client of type "Web application" from Google Cloud Console. Its
# "Authorized redirect URIs" must include GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/callback
FRONTEND_URL=http://localhost:5173
SESSION_DB_PATH=backend/data/sessions.db
RESUMES_DIR=backend/data/resumes
MAX_UPLOAD_BYTES=5242880

# --- Discord bot (discord_bot/) only ---
# Create a bot at https://discord.com/developers/applications, enable "Message Content Intent"
# under Bot settings, and invite it to a server you're in (or it can DM you once you share a server).
DISCORD_BOT_TOKEN=your-discord-bot-token
# Optional: restrict the bot to a single Discord user ID (personal-only mode).
# Leave unset/empty for multi-user mode - anyone who DMs the bot gets their own
# isolated resume/Gmail-token/history, keyed by their Discord user ID.
DISCORD_ALLOWED_USER_ID=
