# Anthropic API key used for JD parsing, matching, and email drafting
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Claude model to use for structured extraction/matching/drafting calls
ANTHROPIC_MODEL=claude-sonnet-5

# Your name and headline used in generated email pitches
CANDIDATE_NAME=Your Name
CANDIDATE_HEADLINE=Software Engineer

# Minimum match score (0-100) required for auto-alignment without confirmation
MATCH_SCORE_THRESHOLD=65

# Path overrides (optional - defaults shown)
PROFILE_PATH=data/profile.md
JOBS_HISTORY_PATH=data/jobs_history.json
GMAIL_CREDENTIALS_PATH=credentials/credentials.json
GMAIL_TOKEN_PATH=credentials/token.json
