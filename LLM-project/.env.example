# mock | groq | openai | ollama  (or set UPSTREAM_URL to any OpenAI-compatible endpoint)
UPSTREAM_PROVIDER=mock
UPSTREAM_API_KEY=
# UPSTREAM_URL=http://localhost:11434/v1/chat/completions

SIMILARITY_THRESHOLD=0.92
ENTITY_GUARD=true
CACHE_TTL_SECONDS=86400
CACHE_MAX_ENTRIES=50000
EVICTION_INTERVAL_SECONDS=300
QDRANT_PATH=./qdrant_storage

MOCK_LATENCY_MS_MIN=1200
MOCK_LATENCY_MS_MAX=2500
