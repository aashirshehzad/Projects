# Copy to .env and fill in. Never commit the real .env.

# --- Stage 3: LLM remediation ------------------------------------------------
# Backend for the single structured-JSON call: "gemini" (default) or "openai".
AUDITOR_LLM_PROVIDER=gemini
AUDITOR_LLM_MODEL=gemini-3.5-flash-lite

# Provider key -- only the one matching AUDITOR_LLM_PROVIDER is needed.
GEMINI_API_KEY=
# OPENAI_API_KEY=sk-...
# AUDITOR_LLM_MODEL=gpt-4o-mini   # if provider=openai

AUDITOR_LLM_TEMPERATURE=0.0
AUDITOR_LLM_TIMEOUT_SECONDS=60
AUDITOR_LLM_MAX_TOKENS=8192

# --- Stage 1-2: scan behaviour ---------------------------------------------
AUDITOR_CONTEXT_LINES=5
AUDITOR_MAX_VIOLATIONS_TO_LLM=50

# --- Stage 4: GitHub PR reporting ----------------------------------------
# Usually injected by CI; GITHUB_TOKEN is provided automatically in Actions.
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repo
GITHUB_PR_NUMBER=
GITHUB_SHA=
