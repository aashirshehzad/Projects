# Copy to .env and fill in. Never commit the real .env.

# LLM remediation layer (Stage 3)
OPENAI_API_KEY=sk-...
AUDITOR_LLM_MODEL=gpt-4o-mini
AUDITOR_LLM_TEMPERATURE=0.0
AUDITOR_LLM_TIMEOUT_SECONDS=30
AUDITOR_LLM_MAX_TOKENS=1200

# Scan behaviour
AUDITOR_CONTEXT_LINES=5
AUDITOR_MAX_VIOLATIONS_TO_LLM=50

# GitHub PR reporting (Stage 4) -- usually injected by CI as GITHUB_TOKEN
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repo
GITHUB_PR_NUMBER=
GITHUB_SHA=
