# Copy this file to ".env" and fill in your key.
# Get a key at https://aistudio.google.com/apikey

GEMINI_API_KEY=paste-your-gemini-api-key-here

# Optional overrides. If this model id is rejected, the backend error will list
# the valid ids for your key (or run:  python -m app.list_models).
GEMINI_MODEL=gemini-3.5-flash-lite
# Comma-separated list of origins allowed to call the API (the React dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Email tool (send_email) ----
# Lets the agent email an answer to a recipient the user types in chat.
# Sent FROM this Gmail via a Google App Password (needs 2-Step Verification on):
#   https://myaccount.google.com/apppasswords
EMAIL_ENABLED=0
GMAIL_ADDRESS=aashirshehzad111@gmail.com
GMAIL_APP_PASSWORD=paste-16-char-app-password-here
# Optional: restrict who can be emailed (comma list). Empty = any address.
EMAIL_ALLOWED_RECIPIENTS=
# Optional: simple abuse guard.
EMAIL_MAX_PER_HOUR=10
