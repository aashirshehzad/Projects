# Copy this file to ".env" and fill in your key.
# Get a key at https://aistudio.google.com/apikey

GEMINI_API_KEY=paste-your-gemini-api-key-here

# Optional overrides. If this model id is rejected, the backend error will list
# the valid ids for your key (or run:  python -m app.list_models).
GEMINI_MODEL=gemini-3.5-flash-lite
# Comma-separated list of origins allowed to call the API (the React dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
